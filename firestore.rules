rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{roomId} {
      function isValidRoomCreate() {
        let d = request.resource.data;
        return d.keys().hasOnly(['roomId','createdAt','expiresAt','status','hostId','billData','settings'])
          && d.roomId == roomId
          && d.hostId == request.auth.uid
          && d.status == 'active'
          && d.createdAt is timestamp
          && d.expiresAt is timestamp
          && d.billData is map
          && d.settings is map;
      }

      // `hostId` names whoever scanned the receipt. It is NOT a social role — this
      // app is for diners splitting a bill between themselves, with nobody
      // collecting. It grants exactly two powers: edit the bill items, and close
      // the bill. Everything else is equal for everyone.
      function isReceiptScanner() {
        return request.auth != null && request.auth.uid == resource.data.hostId;
      }

      allow get: if request.auth != null;
      allow list: if false; // never allow enumerating every room in the database
      allow create: if request.auth != null && isValidRoomCreate();

      // Bill/settings edits: scanner only, so prices can't shift under the group.
      allow update: if isReceiptScanner()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['billData', 'settings']);

      // Closing (or reopening) the bill: scanner only, and `status` must stay one
      // of the two known values so a client can't write arbitrary junk into it.
      allow update: if isReceiptScanner()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
                    && request.resource.data.status in ['active', 'completed'];

      allow delete: if false; // TTL policies handle cleanup

      match /participants/{participantId} {
        function isValidParticipantCreate() {
          let d = request.resource.data;
          return d.keys().hasOnly(['id','name','isHost','joinedAt','selections','customTipPercentage','paid','expiresAt'])
            && d.id == participantId
            && d.name is string && d.name.size() > 0 && d.name.size() < 60
            && d.selections is list && d.selections.size() < 200
            && d.paid == false
            && d.expiresAt is timestamp;
        }

        allow get: if request.auth != null;
        allow list: if request.auth != null; // needed to assemble "who's in this (already-known) room"
        allow create: if request.auth != null && request.auth.uid == participantId && isValidParticipantCreate();
        allow update: if request.auth != null && request.auth.uid == participantId
                      && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['selections','customTipPercentage','paid'])
                      && request.resource.data.name == resource.data.name
                      && request.resource.data.isHost == resource.data.isHost;
        // You may leave a room yourself, and the receipt scanner may remove
        // someone (a duplicate join, or a typo'd name). Nobody else can remove
        // anyone — deleting a participant also deletes their claims, which
        // changes what everyone else owes on shared dishes.
        allow delete: if request.auth != null
                      && (request.auth.uid == participantId
                          || request.auth.uid == get(/databases/$(database)/documents/rooms/$(roomId)).data.hostId);
      }
    }
  }
}
